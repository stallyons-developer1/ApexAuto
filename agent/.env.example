# Copy this file to .env (same folder) and fill it in. Never commit .env.

# The booking app on Railway
APP_URL=https://bartolome-production.up.railway.app
# Must equal TF_AGENT_KEY in the Railway variables
TF_AGENT_KEY=

# TruthFinder login (stays on this computer)
TF_EMAIL=
TF_PASSWORD=

# Optional
# TF_HEADLESS=false          # false = visible Chrome window (default)
# TF_BROWSER_CHANNEL=chrome  # use the installed Google Chrome (default); empty = bundled Chromium
# TF_MIN_GAP_SECONDS=45      # pause between searches
# POLL_SECONDS=10            # how often to ask the app for work
